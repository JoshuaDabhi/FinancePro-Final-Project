<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - FinancePro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 font-sans relative">

    <nav class="bg-white shadow-md sticky top-0 z-40">
        <div class="container mx-auto px-6 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-blue-600 text-white p-2 rounded-lg"><i class="fas fa-chart-line"></i></div>
                <span class="text-xl font-bold text-gray-800">Finance<span class="text-blue-600">Pro</span></span>
            </div>
            <div class="flex items-center space-x-6">
                <div class="hidden md:flex space-x-2">
                    <a href="/reports/csv" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1 rounded border"><i class="fas fa-file-csv mr-1"></i> CSV</a>
                    <a href="/reports/pdf" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1 rounded border"><i class="fas fa-file-pdf mr-1"></i> PDF</a>
                </div>
                <div class="flex items-center space-x-2">
                    <div class="text-right leading-tight">
                        <p class="text-sm font-bold text-gray-800"><%= user.name %></p>
                        <p class="text-xs text-gray-500">User</p>
                    </div>
                    <a href="/users/logout" class="text-red-500 hover:text-red-700 ml-4"><i class="fas fa-sign-out-alt text-lg"></i></a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mx-auto mt-8 px-4 mb-20">
        
        <% if(locals.sessionAlert) { %>
            <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded shadow flex justify-between items-center">
                <p class="font-bold"><%= sessionAlert %></p>
                <button onclick="this.parentElement.remove()" class="text-red-700 font-bold">x</button>
            </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 p-6 rounded-xl shadow-lg text-white">
                <h3 class="text-blue-100 text-xs uppercase font-bold">Current Balance</h3>
                <p class="text-4xl font-bold mt-2">$<%= user.currentBalance.toFixed(2) %></p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100">
                <h3 class="text-gray-400 text-xs uppercase font-bold">Monthly Expenses</h3>
                <p class="text-3xl font-bold text-red-500 mt-2">$<%= totalExpenses %></p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100">
                <h3 class="text-gray-400 text-xs uppercase font-bold">Active Savings Goals</h3>
                <p class="text-3xl font-bold text-green-500 mt-2"><%= goals.length %></p>
            </div>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
            <div class="xl:col-span-1 space-y-8">
                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="font-bold text-gray-700">Budgets</h2>
                        <form action="/features/budget/add" method="POST" class="flex space-x-1">
                            <select name="category" class="w-20 text-xs border rounded"><option>Food</option><option>Rent</option><option>Transport</option><option>Entertainment</option></select>
                            <input type="number" name="limit" placeholder="$" class="w-12 text-xs border rounded">
                            <button class="bg-blue-100 text-blue-600 px-2 rounded">+</button>
                        </form>
                    </div>
                    <% if(budgets.length > 0) { %>
                        <div class="space-y-4">
                            <% budgets.forEach(b => { %>
                                <div>
                                    <div class="flex justify-between text-xs mb-1">
                                        <span class="font-bold text-gray-600"><%= b.category %></span>
                                        <span class="<%= b.spent > b.limit ? 'text-red-600 font-bold' : 'text-gray-500' %>">$<%= b.spent %> / $<%= b.limit %></span>
                                    </div>
                                    <div class="w-full bg-gray-100 h-2 rounded-full"><div class="h-2 rounded-full <%= b.spent > b.limit ? 'bg-red-500' : 'bg-blue-500' %>" style="width: <%= b.percentage %>%"></div></div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %><p class="text-xs text-gray-400 italic">No budgets set.</p><% } %>
                </div>

                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                    <h2 class="font-bold text-gray-700 mb-4">Bill Reminders</h2>
                    <form action="/bills/add" method="POST" class="mb-4 bg-gray-50 p-3 rounded">
                        <div class="grid grid-cols-2 gap-2 mb-2">
                            <input type="text" name="title" placeholder="Title" class="text-xs p-2 border rounded" required>
                            <input type="number" name="amount" placeholder="$" class="text-xs p-2 border rounded" required>
                        </div>
                        <div class="grid grid-cols-2 gap-2 mb-2">
                            <select name="category" class="text-xs p-2 border rounded bg-white" required>
                                <option value="" disabled selected>Category</option>
                                <option value="Rent">Rent</option>
                                <option value="Utilities">Utilities</option>
                                <option value="Transportation">Transport</option>
                                <option value="Entertainment">Fun</option>
                                <option value="Health">Health</option>
                                <option value="Other">Other</option>
                            </select>
                            <input type="date" name="dueDate" class="text-xs p-2 border rounded" required>
                        </div>
                        <div class="mb-2">
                            <input type="time" name="dueTime" class="w-full text-xs p-2 border rounded">
                        </div>
                        <button class="w-full mt-2 bg-purple-600 text-white text-xs font-bold py-1 rounded">Set Reminder</button>
                    </form>
                    
                    <% if(bills.length > 0) { %>
                        <div class="space-y-3">
                            <% bills.forEach(bill => { %>
                                <div class="flex justify-between items-center p-2 border rounded hover:bg-gray-50">
                                    <div>
                                        <p class="font-bold text-sm"><%= bill.title %></p>
                                        <p class="text-xs text-gray-500"><%= bill.category %></p> <p class="text-xs text-red-500"><%= bill.dueDate.toLocaleDateString() %> <%= bill.dueTime ? '@ ' + bill.dueTime : '' %></p>
                                    </div>
                                    <div class="flex space-x-2">
                                        <span class="font-bold text-sm mr-2">$<%= bill.amount %></span>
                                        <form action="/bills/pay/<%= bill._id %>" method="POST"><button class="text-green-500"><i class="fas fa-check-circle"></i></button></form>
                                        <form action="/bills/delete/<%= bill._id %>" method="POST"><button class="text-gray-400"><i class="fas fa-trash"></i></button></form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="xl:col-span-2 space-y-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                        <h2 class="font-bold text-gray-700 mb-4">New Transaction</h2>
                        <form action="/transactions/add" method="POST" enctype="multipart/form-data">
                            <div class="flex space-x-2 mb-3">
                                <select name="type" class="w-1/3 text-sm border rounded p-2"><option value="expense">Expense</option><option value="income">Income</option></select>
                                <input type="number" step="0.01" name="amount" placeholder="0.00" class="w-2/3 text-sm border rounded p-2 font-bold" required>
                            </div>
                            <div class="flex space-x-2 mb-3">
                                <select name="category" class="w-1/2 text-sm border rounded p-2">
                                    <option value="Food">Food</option><option value="Rent">Rent</option><option value="Utilities">Utilities</option>
                                    <option value="Transportation">Transport</option><option value="Entertainment">Fun</option><option value="Health">Health</option><option value="Other">Other</option>
                                </select>
                                <input type="text" name="description" placeholder="Note..." class="w-1/2 text-sm border rounded p-2">
                            </div>
                            <div class="flex justify-between items-center">
                                <input type="file" name="receipt" class="text-xs text-gray-400">
                                <button class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-blue-700">Add</button>
                            </div>
                        </form>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 overflow-y-auto max-h-64">
                        <div class="flex justify-between items-center mb-2">
                            <h2 class="font-bold text-gray-700">Goals</h2>
                            <form action="/features/goal/add" method="POST" class="flex"><input name="title" placeholder="Goal" class="w-16 border text-xs"><input name="targetAmount" type="number" placeholder="$" class="w-12 border text-xs"><button class="bg-green-500 text-white px-1 text-xs">+</button></form>
                        </div>
                        <% goals.forEach(g => { let p = Math.min((g.savedAmount/g.targetAmount)*100, 100); %>
                            <div class="mb-3 border-b pb-2">
                                <div class="flex justify-between text-xs font-bold"><span class="text-gray-700"><%= g.title %></span><span class="text-green-600">$<%= g.savedAmount %> / $<%= g.targetAmount %></span></div>
                                <div class="w-full bg-gray-100 h-1.5 rounded-full mt-1"><div class="bg-green-500 h-1.5 rounded-full" style="width: <%= p %>%"></div></div>
                                <form action="/features/goal/contribute/<%= g._id %>" method="POST" class="mt-1 flex justify-end"><input name="amount" placeholder="$" class="w-10 text-xs border"><button class="text-xs text-blue-500 ml-1">Save</button></form>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 md:col-span-1 flex flex-col justify-center">
                        <h3 class="text-center text-xs font-bold text-gray-500 mb-2">Breakdown</h3>
                        <div class="h-40"><canvas id="expenseChart"></canvas></div>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 md:col-span-2">
                        <h3 class="font-bold text-gray-700 mb-3">Recent Activity</h3>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <tbody class="text-sm">
                                    <% transactions.slice(0, 6).forEach(t => { %>
                                        <tr class="border-b last:border-0">
                                            <td class="py-2 text-gray-500 text-xs"><%= t.date.toLocaleDateString() %></td>
                                            <td class="py-2 font-bold text-gray-700"><%= t.category %></td>
                                            <td class="py-2 text-right font-bold <%= t.type === 'income' ? 'text-green-500' : 'text-red-500' %>"><%= t.type === 'income' ? '+' : '-' %>$<%= t.amount %></td>
                                            <td class="py-2 text-right"><% if(t.receipt) { %><a href="/uploads/<%= t.receipt %>" target="_blank" class="text-blue-400"><i class="fas fa-paperclip"></i></a><% } %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="alertModal" class="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white p-6 rounded-lg shadow-xl w-96 border-t-4 border-red-500 animate-bounce-short">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-circle text-red-500 text-2xl"></i>
                </div>
                <div class="ml-3 w-full">
                    <h3 class="text-lg font-bold text-gray-900">Action Required</h3>
                    <div class="mt-2 text-sm text-gray-600">
                        <p>The following bills are overdue or due soon:</p>
                        <ul class="list-disc ml-4 mt-2 space-y-2">
                            <% alerts.forEach(bill => { 
                                const isOverdue = new Date(bill.dueDate) < new Date().setHours(0,0,0,0);
                            %>
                                <li>
                                    <div class="flex justify-between">
                                        <span class="font-bold"><%= bill.title %></span>
                                        <span class="font-mono">$<%= bill.amount %></span>
                                    </div>
                                    <% if(isOverdue) { %>
                                        <span class="text-xs text-red-600 font-bold uppercase">Overdue (<%= bill.dueDate.toLocaleDateString() %>)</span>
                                    <% } else { %>
                                        <span class="text-xs text-yellow-600 font-bold">Due Soon (<%= bill.dueDate.toLocaleDateString() %>)</span>
                                    <% } %>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                    <div class="mt-4">
                        <button onclick="closeModal()" class="w-full bg-red-600 text-white font-bold py-2 rounded hover:bg-red-700">Acknowledge</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = <%- chartLabels %>; const data = <%- chartData %>;     
        if (labels.length > 0) { new Chart(document.getElementById('expenseChart').getContext('2d'), { type: 'doughnut', data: { labels, datasets: [{ data, backgroundColor: ['#3B82F6', '#EF4444', '#10B981', '#F59E0B', '#8B5CF6'], borderWidth: 0 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } } }); }

        const alertsExist = <%= alerts.length > 0 %>;
        const modal = document.getElementById('alertModal');
        if (alertsExist) modal.classList.remove('hidden');
        function closeModal() { modal.classList.add('hidden'); }
    </script>
</body>
</html>